generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole @default(MERCHANT)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("users")
}

model transaction {
  id                String                    @id @default(cuid())
  transactionId     String                    @unique(map: "Transaction_transactionId_key")
  merchantId        String
  amount            Decimal                   @db.Decimal(12, 2)
  currency          String                    @db.VarChar(3)
  status            transaction_status        @default(PENDING)
  paymentMethod     transaction_paymentMethod
  customerReference String?
  qrPayload         String?
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  @@index([merchantId, createdAt], map: "Transaction_merchantId_createdAt_idx")
  @@index([merchantId], map: "Transaction_merchantId_idx")
  @@index([merchantId, status], map: "Transaction_merchantId_status_idx")
}

enum UserRole {
  ADMIN
  MERCHANT
}

enum transaction_status {
  PENDING
  SUCCESSFUL
  FAILED
}

enum transaction_paymentMethod {
  QR
}
